{
  layout: grid; columns: repeat(2); gap: 28; padding: 28; fill: --bg; routing: straight; clearance: 18; font-size: 13;

  |group| {
    direction: column; gap: 16; padding: 18; radius: 10; stroke-style: dashed; routing: orthogonal;
  }

  |box| { max-width: 220; padding: 13; radius: 7; }

  |-| { stroke: --gray-deep; stroke-width: 1.5; }

  .hero {
    fill: gradient(--sky, --teal); stroke: none; color: white; font-size: 20; font-weight: bold;
  }

  .model { fill: --sky-wash; stroke: --sky-ink; color: --sky-ink; }

  .storage { fill: --orange-wash; stroke: --orange-ink; color: --orange-ink; }

  .compute { fill: --teal-wash; stroke: --teal-ink; color: --teal-ink; }

  .support { fill: --purple-wash; stroke: --purple-ink; color: --purple-ink; }

  .boundary { stroke: --purple-deep; stroke-style: dashed; }

  .test { stroke: --gray-deep; stroke-style: dotted; }
}

|box#title| "rivet-core\nTensor storage, layouts, dtypes & operations" .hero {
  cell: 1 1; span: 2 1;
}

|group#tensor| "Tensor model" { cell: 1 2; } [
  |box#tensor_api| "Tensor / ExclusiveTensor\nowned and view-backed tensors" .model
  |box#layout| "Layout + Shape\nstrides, bounds, indexing" .model
  |box#dtype| "DType + WithDType\nstatic dtype dispatch" .model

  tensor_api -> layout "views / offsets"
  tensor_api -> dtype "typed values"
]

|group#storage| "Storage & devices" { cell: 2 2; } [
  |box#storage_trait| "Storage trait\nshared backing and slices" .storage
  |box#cpu| "CpuStorage / CpuDevice\naligned CPU buffers" .storage
  |box#device| "Device + DeviceLocation\nCPU placement contract" .storage

  cpu -> storage_trait "implements"
  cpu -> device "runs on"
]

|group#ops| "Operations & backends" { cell: 1 3; } [
  |box#ops_api| "ops::{Unary, Binary, Reduce, Cmp}\noperation definitions" .compute
  |box#backend| "Backend traits\noperation dispatch" .compute
  |box#cpu_math| "cpu_backend\nindexing, math, matmul" .compute

  ops_api -> backend "dispatches"
  backend -> cpu_math "CPU implementation"
]

|group#validation| "Validation & support" { cell: 2 3; } [
  |box#error| "Error + Result\nshape and storage failures" .support
  |box#strided| "StridedIndex\nchecked coordinate access" .support
  |box#tests| "tensor tests + benches\nlayout and buffer coverage" .test

  strided -> error "reports bounds"
  tests --- strided "asserts behavior" .test
]

tensor -> storage .boundary
ops -> validation .boundary
